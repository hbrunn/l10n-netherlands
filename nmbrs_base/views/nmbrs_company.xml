<data>
    <record id="view_nmbrs_company_form" model="ir.ui.view">
        <field name="model">nmbrs.company</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                <group name="main">
                    <field name="nmbrs_id" />
                    <field name="name" />
                    <field name="company_id" groups="base.group_multi_company" />
                </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_nmbrs_company_tree" model="ir.ui.view">
        <field name="model">nmbrs.company</field>
        <field name="arch" type="xml">
            <tree>
                    <field name="nmbrs_id" />
                    <field name="name" />
                    <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>
</data>
