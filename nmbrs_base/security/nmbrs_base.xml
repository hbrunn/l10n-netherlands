<odoo>
<data>
    <record id="category_nmbrs" model="ir.module.category">
        <field name="name">Nmbrs integration</field>
    </record>
</data>
<data noupdate="1">
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="category_nmbrs" />
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="category_nmbrs" />
        <field name="implied_ids" eval="[Command.link(ref('group_user'))]" />
    </record>
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[Command.link(ref('group_manager'))]" />
    </record>
</data>
</odoo>
